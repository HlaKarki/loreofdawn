{
	"name": "loreofdawn",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "oxlint",
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:worker": "turbo -F worker dev",
		"app": "turbo dev -F web -F worker",
		"db:push": "turbo -F @repo/database db:push",
		"db:studio": "turbo -F @repo/database db:studio",
		"format": "prettier . --write",
		"format:check": "prettier . --check"
	},
	"devDependencies": {
		"oxlint": "^1.12.0",
		"prettier": "^3.6.2",
		"turbo": "^2.5.4"
	},
	"packageManager": "bun@1.4.0"
}
